<!-- CSS -->
<style>
.carousel-system {
  max-width: 100%;
  margin: 0 auto;
}

.carousel {
  overflow: hidden;
}

.carousel-track {
  display: flex;
  transition: transform 0.5s ease-in-out;
}

.carousel-track img {
  width: 100%;
  flex: 0 0 100%;
  object-fit: cover;
}

/* Dots Container (after carousel) */
.carousel-dots-container {
  display: flex;
  justify-content: flex-end; /* Align to right */
  padding: 15px 20px;
}

/* Vertical Dots */
.carousel-dots-vertical {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 12px;
}

.carousel-dots-vertical .dot {
  display: block;
  width: 12px;
  height: 12px;
  background-color: #000;
  border-radius: 50%;
  cursor: pointer;
  transition: all 0.3s ease;
}

.carousel-dots-vertical .dot.active {
  background-color: #2F79BC;
  transform: scale(1.2);
}

.carousel-dots-vertical .dot:not(.active):hover {
  background-color: #444;
}
</style>

<!-- JS -->
<script type="rocketlazyloadscript">
let currentIndex = 0;
const track = document.querySelector('.carousel-track');
const dots = document.querySelectorAll('.carousel-dots-vertical .dot');
const slideCount = track.children.length;

function updateCarousel(index) {
  track.style.transform = 'translateX(' + (-index * 100) + '%)';
  dots.forEach(dot => dot.classList.remove('active'));
  dots[index].classList.add('active');
}

dots.forEach((dot, index) => {
  dot.addEventListener('click', () => {
    currentIndex = index;
    updateCarousel(index);
  });
});

setInterval(() => {
  currentIndex = (currentIndex + 1) % slideCount;
  updateCarousel(currentIndex);
}, 4000);
</script>				</div>
