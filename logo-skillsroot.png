<body class="home wp-singular page-template page-template-elementor_header_footer page page-id-163 wp-custom-logo wp-theme-csr-theme elementor-default elementor-template-full-width elementor-kit-71 elementor-page elementor-page-163">
		<div data-elementor-type="header" data-elementor-id="143" class="elementor elementor-143 elementor-location-header" data-elementor-post-type="elementor_library">
					<div class="elementor-section-wrap">
						<div class="elementor-element elementor-element-31c9102 e-flex e-con-boxed e-con e-parent" data-id="31c9102" data-element_type="container">
					<div class="e-con-inner">
				<div class="elementor-element elementor-element-217e1a3 elementor-widget elementor-widget-html" data-id="217e1a3" data-element_type="widget" data-widget_type="html.default">
					<style>
  .custom-header {
    position: fixed;
    top: 0px;
    left: 0;
    width: 100%;
    background: #fff;
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 15px 50px;
    box-shadow: 0 2px 8px rgba(0,0,0,0.05);
    transition: all 0.3s ease;
    z-index: 9999;
  }

  .custom-header.shrink {
    padding: 8px 50px;
  }

  .custom-header .logo img {
    height: 70px;
    transition: all 0.3s ease;
        margin-left: 98px;
  }

  .custom-header.shrink .logo img {
    height: 45px;
  }

  .nav-menu {
    display: flex;
    gap: 30px;
    align-items: center;
  }

  .nav-menu a {
    text-decoration: none;
    font-size: 16px;
    color: #111;
    position: relative;
    transition: color 0.3s ease;
  }

  .nav-menu a:hover {
    color: #e74c3c;
  }

  /* Dropdown */
  .dropdown {
    position: relative;
  }

  .dropdown-content {
    display: none;
    position: absolute;
    top: 100%;
    left: 0;
    background: #fff;
    min-width: 200px;
    box-shadow: 0 2px 8px rgba(0,0,0,0.1);
    padding: 10px 0;
    z-index: 999;
  }

  .dropdown-content a {
    display: block;
    padding: 10px 20px;
    color: #111;
    text-decoration: none;
    font-size: 15px;
  }

  .dropdown-content a:hover {
    background: #f2f2f2;
    color: #e74c3c;
  }

  .dropdown:hover .dropdown-content {
    display: block;
  }

  /* Search icon */
  .search-icon {
    font-size: 18px;
    cursor: pointer;
  }

  /* Hamburger styles */
  .hamburger {
    display: none;
    flex-direction: column;
    cursor: pointer;
    gap: 5px;
  }

  .hamburger span {
    width: 25px;
    height: 3px;
    background: #111;
    border-radius: 2px;
    transition: all 0.3s ease;
  }

  /* MOBILE ENHANCEMENTS */
  @media (max-width: 992px) {
    /* Enhanced header for mobile */
    .custom-header {
      padding: 15px 20px;
      background: rgba(255, 255, 255, 0.95);
      backdrop-filter: blur(20px);
      -webkit-backdrop-filter: blur(20px);
      border-bottom: 1px solid rgba(0, 0, 0, 0.05);
    }
    


    .custom-header.shrink {
      padding: 10px 20px;
      background: rgba(255, 255, 255, 0.98);
      box-shadow: 0 8px 40px rgba(0, 0, 0, 0.12);
    }

    .custom-header .logo img {
      height: 50px;
      filter: drop-shadow(0 2px 8px rgba(0, 0, 0, 0.1));
      margin-left: 0px;
    }

    .custom-header.shrink .logo img {
      height: 40px;
    }

    /* Cool Hamburger Animation */
    .hamburger {
      display: flex;
      padding: 8px;
      border-radius: 12px;
      transition: all 0.3s ease;
      position: relative;
      z-index: 10001;
    }

    .hamburger:hover {
      background: rgba(231, 76, 60, 0.1);
      transform: scale(1.05);
    }

    .hamburger span {
      width: 24px;
      height: 2.5px;
      background: linear-gradient(135deg, #e74c3c, #c0392b);
      border-radius: 10px;
      transition: all 0.4s cubic-bezier(0.68, -0.55, 0.265, 1.55);
      transform-origin: center;
    }

    .hamburger.open span:nth-child(1) {
      transform: rotate(45deg) translate(6px, 6px);
      background: linear-gradient(135deg, #e74c3c, #8e44ad);
    }

    .hamburger.open span:nth-child(2) {
      opacity: 0;
      transform: scale(0);
    }

    .hamburger.open span:nth-child(3) {
      transform: rotate(-45deg) translate(6px, -6px);
      background: linear-gradient(135deg, #e74c3c, #8e44ad);
    }

    /* Mobile Menu Overlay */
    .nav-menu {
      position: fixed;
      top: 0;
      left: -100%;
      width: 100vw;
      height: 100vh;
      background: linear-gradient(135deg, rgba(231, 76, 60, 0.95), rgba(142, 68, 173, 0.95));
      backdrop-filter: blur(30px);
      -webkit-backdrop-filter: blur(30px);
      flex-direction: column;
      justify-content: center;
      align-items: center;
      gap: 35px;
      padding: 80px 20px 20px;
      transition: all 0.6s cubic-bezier(0.25, 0.8, 0.25, 1);
      box-shadow: none;
      z-index: 10000;
    }

    .nav-menu::before {
      content: '';
      position: absolute;
      top: 0;
      left: 0;
      width: 100%;
      height: 100%;
      background: url('data:image/svg+xml,<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 100 100"><defs><pattern id="grain" width="100" height="100" patternUnits="userSpaceOnUse"><circle cx="25" cy="25" r="1" fill="white" opacity="0.05"/><circle cx="75" cy="75" r="1" fill="white" opacity="0.05"/><circle cx="50" cy="10" r="0.5" fill="white" opacity="0.03"/></pattern></defs><rect width="100" height="100" fill="url(%23grain)"/></svg>');
      opacity: 0.3;
    }

    .nav-menu.active {
      left: 0;
    }

    /* Enhanced Menu Links */
    .nav-menu a {
      font-size: 22px;
      font-weight: 600;
      color: white;
      padding: 15px 30px;
      border-radius: 16px;
      backdrop-filter: blur(10px);
      border: 1px solid rgba(255, 255, 255, 0.1);
      text-align: center;
      min-width: 200px;
      opacity: 0;
      transform: translateY(50px);
      transition: all 0.4s cubic-bezier(0.25, 0.8, 0.25, 1);
      position: relative;
      overflow: hidden;
    }

    .nav-menu.active a {
      opacity: 1;
      transform: translateY(0);
    }

    /* Staggered Animation */
    .nav-menu a:nth-child(1) { transition-delay: 0.1s; }
    .nav-menu .dropdown:nth-child(2) a { transition-delay: 0.2s; }
    .nav-menu .dropdown:nth-child(3) a { transition-delay: 0.3s; }
    .nav-menu a:nth-child(4) { transition-delay: 0.4s; }
    .nav-menu a:nth-child(5) { transition-delay: 0.5s; }

    .nav-menu a:hover {
      background: rgba(255, 255, 255, 0.2);
      transform: translateY(-5px) scale(1.05);
      box-shadow: 0 15px 35px rgba(0, 0, 0, 0.3);
      border-color: rgba(255, 255, 255, 0.3);
    }

    /* Shimmer Effect */
    .nav-menu a::before {
      content: '';
      position: absolute;
      top: 0;
      left: -100%;
      width: 100%;
      height: 100%;
      background: linear-gradient(90deg, transparent, rgba(255, 255, 255, 0.2), transparent);
      transition: left 0.6s ease;
      border-radius: 16px;
    }

    .nav-menu a:hover::before {
      left: 100%;
    }

    /* Dropdown Styles for Mobile */
    .dropdown {
      width: 100%;
      display: flex;
      flex-direction: column;
      align-items: center;
    }

    .dropdown > a {
      display: flex;
      align-items: center;
      gap: 8px;
    }

    .dropdown > a::after {
      content: '▾';
      font-size: 16px;
      transition: transform 0.3s ease;
    }

    .dropdown.open > a::after {
      transform: rotate(180deg);
    }

    .dropdown-content {
      position: static;
      box-shadow: none;
      padding: 15px 0 0;
      background: rgba(255, 255, 255, 0.15);
      border-radius: 12px;
      margin-top: 15px;
      width: 100%;
      max-width: 250px;
      backdrop-filter: blur(15px);
      border: 1px solid rgba(255, 255, 255, 0.1);
      display: none;
    }

    .dropdown:hover .dropdown-content {
      display: none;
    }

    .dropdown.open .dropdown-content {
      display: block;
      animation: slideDown 0.4s ease;
    }

    @keyframes slideDown {
      from {
        opacity: 0;
        transform: translateY(-20px);
      }
      to {
        opacity: 1;
        transform: translateY(0);
      }
    }

    .dropdown-content a {
      color: rgba(255, 255, 255, 0.9) !important;
      font-size: 18px !important;
      font-weight: 500 !important;
      padding: 12px 20px !important;
      border-radius: 8px !important;
      margin: 4px 12px !important;
      min-width: auto !important;
      text-align: left !important;
      backdrop-filter: none !important;
      border: none !important;
      opacity: 1 !important;
      transform: none !important;
      transition: all 0.3s ease !important;
    }

    .dropdown-content a:hover {
      background: rgba(255, 255, 255, 0.2) !important;
      transform: translateX(8px) !important;
      box-shadow: none !important;
    }

    /* Prevent body scroll when menu is open */
    body.menu-open {
      overflow: hidden;
    }
  }

  /* Smaller mobile devices */
  @media (max-width: 480px) {
    .custom-header {
      padding: 12px 16px;
    }
    
    .nav-menu a {
      font-size: 20px;
      min-width: 180px;
      padding: 12px 24px;
    }
    
    .dropdown-content a {
      font-size: 16px !important;
    }
  }
</style>

<header class="custom-header" id="customHeader">
  <div class="logo">
    <a href="https://skillsroot.org.in/">
      <img src="https://skillsroot.org.in/wp-content/uploads/2025/08/Skillsroot-Svss.webp" alt="Skillsroot-Svss">
    </a>
  </div>

  <!-- Hamburger -->
  <div class="hamburger" id="hamburger">
    <span></span>
    <span></span>
    <span></span>
  </div>

  <nav class="nav-menu" id="navMenu">
    <a href="https://skillsroot.org.in/">Home</a>

    <div class="dropdown">
      <a href="https://skillsroot.org.in/?page_id=215">About Us ▾</a>
      <div class="dropdown-content">
      
        <a href="https://skillsroot.org.in/?page_id=395">Media</a>
        <a href="https://skillsroot.org.in/?page_id=250">Our Team</a>
      </div>
    </div>

    <div class="dropdown">
      <a href="https://skillsroot.org.in/?page_id=321">Our Projects ▾</a>
      <div class="dropdown-content">
        <a href="https://skillsroot.org.in/?page_id=314">Success Stories</a>
      </div>
    </div>
  <a href="https://skillsroot.org.in/?page_id=220">Our Partners</a>
    <a href="https://skillsroot.org.in/?page_id=225">Information Desk</a>
    <a href="https://skillsroot.org.in/?page_id=230">Contact Us</a>
  </nav>
</header>

<script type="rocketlazyloadscript">
  const header = document.getElementById("customHeader");
  const hamburger = document.getElementById("hamburger");
  const navMenu = document.getElementById("navMenu");
  const dropdowns = document.querySelectorAll(".dropdown");

  // Shrink header on scroll
  window.addEventListener("scroll", () => {
    if (window.scrollY > 50) {
      header.classList.add("shrink");
    } else {
      header.classList.remove("shrink");
    }
  });

  // Enhanced mobile menu toggle
  hamburger.addEventListener("click", (e) => {
    e.stopPropagation();
    navMenu.classList.toggle("active");
    hamburger.classList.toggle("open");
    
    // Prevent body scroll when menu is open
    if (navMenu.classList.contains("active")) {
      document.body.classList.add("menu-open");
    } else {
      document.body.classList.remove("menu-open");
    }
  });

  // Close menu when clicking outside
  document.addEventListener("click", (e) => {
    if (!navMenu.contains(e.target) && !hamburger.contains(e.target)) {
      navMenu.classList.remove("active");
      hamburger.classList.remove("open");
      document.body.classList.remove("menu-open");
    }
  });

  // Enhanced dropdown toggle for mobile
  dropdowns.forEach(dropdown => {
    const link = dropdown.querySelector("a");
    
    link.addEventListener("click", function(e) {
      if (window.innerWidth <= 992) {
        e.preventDefault();
        
        // Close other dropdowns
        dropdowns.forEach(other => {
          if (other !== dropdown) {
            other.classList.remove("open");
          }
        });
        
        dropdown.classList.toggle("open");
      }
    });
  });

  // Close menu on window resize
  window.addEventListener("resize", () => {
    if (window.innerWidth > 992) {
      navMenu.classList.remove("active");
      hamburger.classList.remove("open");
      document.body.classList.remove("menu-open");
      dropdowns.forEach(dropdown => {
        dropdown.classList.remove("open");
      });
    }
  });
</script>				</div>
