		<style type="text/css" id="wp-custom-css">
			/* Ensure parent menu items can hold dropdowns */
.elementor-nav-menu .menu-item {
    position: relative;
}

/* Submenu styling */
.elementor-nav-menu .sub-menu {
    display: none;
    position: absolute;
    top: 100%; /* directly below parent */
    left: 0;
    background: #fff;
    min-width: 200px;
    padding: 10px 0;
    box-shadow: 0 4px 15px rgba(0,0,0,0.15);
    z-index: 99999; /* keep above everything */
}

/* Show submenu on hover */
.elementor-nav-menu li:hover > .sub-menu {
    display: block;
}

/* Make sure header and nav are above all other sections */
header,
.elementor-location-header {
    position: relative;
    z-index: 99999;
    overflow: visible !important;
}

/* Prevent clipping inside Elementor containers */
.elementor-section,
.elementor-container,
.elementor-widget {
    overflow: visible !important;
}

/* Extra fix for Elementor nav */
.elementor-nav-menu {
    overflow: visible !important;
    z-index: 99999;
}
/* Join Form Wrapper */
.wpforms-container.join {
  max-width: 700px;
  margin: 40px auto;
  padding: 30px;
  background: #fff;
  border-radius: 20px;
  box-shadow: 0 6px 25px rgba(0, 0, 0, 0.08);
  font-family: 'Inter', sans-serif;
}

/* Form Labels */
.wpforms-container.join label {
  display: block;
  font-weight: 500;
  margin-bottom: 8px;
  color: #333;
  font-size: 15px;
}

/* Form Inputs */
.wpforms-container.join input[type="text"],
.wpforms-container.join input[type="email"],
.wpforms-container.join input[type="tel"],
.wpforms-container.join input[type="url"],
.wpforms-container.join input[type="file"],
.wpforms-container.join select,
.wpforms-container.join textarea {
  width: 100%;
  padding: 14px 16px;
  border: 1px solid #ddd;
  border-radius: 12px;
  margin-bottom: 20px;
  font-size: 15px;
  transition: all 0.2s ease;
  background: #fafafa;
}

/* Focus Effect */
.wpforms-container.join input:focus,
.wpforms-container.join select:focus,
.wpforms-container.join textarea:focus {
  outline: none;
  border-color: #0077b5; /* LinkedIn blue */
  box-shadow: 0 0 0 3px rgba(0, 119, 181, 0.15);
  background: #fff;
}

/* Textarea */
.wpforms-container.join textarea {
  min-height: 120px;
  resize: vertical;
}

/* Checkbox + Radio */
.wpforms-container.join input[type="checkbox"],
.wpforms-container.join input[type="radio"] {
  margin-right: 8px;
  transform: scale(1.2);
}

/* Submit Button */
.wpforms-container.join .joinbutton {
  display: inline-block;
  width: 100%;
  padding: 14px;
  font-size: 16px;
  font-weight: 600;
  color: #fff;
  background: linear-gradient(135deg, #0077b5, #005582);
  border: none;
  border-radius: 12px;
  cursor: pointer;
  transition: all 0.3s ease;
  text-align: center;
}

/* Button Hover */
.wpforms-container.join .joinbutton:hover {
  background: linear-gradient(135deg, #005582, #003f63);
  transform: translateY(-2px);
  box-shadow: 0 6px 20px rgba(0, 87, 130, 0.3);
}

/* Success Message Style */
.wpforms-container.join .wpforms-confirmation-container-full {
  margin-top: 20px;
  padding: 18px;
  background: #e6f7ef;
  border-left: 5px solid #2ecc71;
  border-radius: 12px;
  font-size: 15px;
  color: #2d864b;
}

html, body {
  margin: 0;
  padding: 0;
}

.elementor-section {
  margin: 0 !important;
  padding: 0 !important;
}


		</style>
