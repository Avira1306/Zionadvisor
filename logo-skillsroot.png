<style>
* {
    box-sizing: border-box;
}

.carousel-container {
    position: relative;
    width: 100%;
    height: 70vh;
    min-height: 400px;
    overflow: hidden;
    border-radius: 20px;
    box-shadow: 0 25px 50px rgba(0,0,0,0.15);
    margin: 0 auto;
}

.carousel-wrapper {
    position: relative;
    width: 100%;
    height: 100%;
    overflow: hidden;
    border-radius: 20px;
}

.carousel-track {
    display: flex;
    height: 100%;
    transition: transform 0.8s cubic-bezier(0.25, 0.46, 0.45, 0.94);
    will-change: transform;
}

.slide {
    position: relative;
    flex: 0 0 100%;
    width: 100%;
    height: 100%;
    overflow: hidden;
}

.slide img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.8s ease;
    will-change: transform;
}

.slide.active img {
    transform: scale(1.05);
}

.slide-overlay {
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    background: linear-gradient(45deg, rgba(0,0,0,0.1) 0%, transparent 50%, rgba(255,255,255,0.1) 100%);
    opacity: 0;
    transition: opacity 0.6s ease;
    pointer-events: none;
}

.slide.active .slide-overlay {
    opacity: 1;
}

/* Progress bar */
.progress-container {
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    height: 3px;
    background: rgba(255,255,255,0.3);
    z-index: 10;
}

.progress-bar {
    height: 100%;
    width: 0%;
    background: linear-gradient(90deg, #2F79BC, #4A9FE7);
    transition: width 0.1s linear;
    box-shadow: 0 0 10px rgba(47, 121, 188, 0.5);
}

/* Navigation dots */
.dots-container {
    position: absolute;
    bottom: 30px;
    right: 30px;
    z-index: 10;
}

.dots-wrapper {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 15px;
    padding: 15px;
    background: rgba(255,255,255,0.1);
    backdrop-filter: blur(10px);
    border-radius: 25px;
    border: 1px solid rgba(255,255,255,0.2);
    box-shadow: 0 8px 32px rgba(0,0,0,0.1);
}

.dot {
    display: block;
    width: 12px;
    height: 12px;
    border-radius: 50%;
    background: rgba(255,255,255,0.5);
    cursor: pointer;
    transition: all 0.4s cubic-bezier(0.25, 0.46, 0.45, 0.94);
    position: relative;
    border: 2px solid transparent;
}

.dot::before {
    content: '';
    position: absolute;
    top: -4px;
    left: -4px;
    right: -4px;
    bottom: -4px;
    border-radius: 50%;
    background: rgba(47, 121, 188, 0.3);
    opacity: 0;
    transform: scale(0.8);
    transition: all 0.4s ease;
}

.dot.active {
    background: #2F79BC;
    transform: scale(1.3);
    box-shadow: 0 0 20px rgba(47, 121, 188, 0.6);
    border-color: rgba(255,255,255,0.8);
}

.dot.active::before {
    opacity: 1;
    transform: scale(1);
}

.dot:hover:not(.active) {
    background: rgba(255,255,255,0.8);
    transform: scale(1.1);
}

/* Swipe hint */
.swipe-hint {
    position: absolute;
    bottom: 100px;
    left: 50%;
    transform: translateX(-50%);
    display: flex;
    align-items: center;
    gap: 15px;
    color: rgba(255,255,255,0.8);
    font-size: 14px;
    font-weight: 500;
    z-index: 10;
    animation: fadeInUp 2s ease, pulse 3s ease infinite 2s;
    background: rgba(0,0,0,0.3);
    backdrop-filter: blur(10px);
    padding: 10px 20px;
    border-radius: 25px;
    border: 1px solid rgba(255,255,255,0.2);
}

.swipe-arrow {
    font-size: 20px;
    font-weight: bold;
    animation: bounce 2s ease infinite;
}

.swipe-arrow.left {
    animation-delay: 0s;
}

.swipe-arrow.right {
    animation-delay: 0.5s;
}

/* Touch feedback */
.carousel-track.touching {
    transition: none;
}

.carousel-track.releasing {
    transition: transform 0.4s cubic-bezier(0.25, 0.46, 0.45, 0.94);
}

/* Mobile optimizations */
@media (max-width: 768px) {
    .carousel-container {
        height: 60vh;
        min-height: 350px;
        border-radius: 15px;
        margin: 10px;
    }
    
    .carousel-wrapper {
        border-radius: 15px;
    }
    
    .dots-container {
        bottom: 20px;
        right: 20px;
    }
    
    .dots-wrapper {
        gap: 12px;
        padding: 12px;
    }
    
    .dot {
        width: 10px;
        height: 10px;
    }
    
    .swipe-hint {
        bottom: 80px;
        font-size: 12px;
        padding: 8px 16px;
    }
    
    .progress-container {
        height: 2px;
    }
}

@media (max-width: 480px) {
    .carousel-container {
        height: 50vh;
        min-height: 300px;
        border-radius: 10px;
        margin: 5px;
    }
    
    .swipe-hint {
        display: none;
    }
    
    .dots-wrapper {
        gap: 10px;
        padding: 10px;
    }
}

/* Animations */
@keyframes fadeInUp {
    from {
        opacity: 0;
        transform: translateX(-50%) translateY(20px);
    }
    to {
        opacity: 1;
        transform: translateX(-50%) translateY(0);
    }
}

@keyframes pulse {
    0%, 100% { opacity: 0.8; }
    50% { opacity: 1; }
}

@keyframes bounce {
    0%, 20%, 50%, 80%, 100% {
        transform: translateY(0);
    }
    40% {
        transform: translateY(-5px);
    }
    60% {
        transform: translateY(-3px);
    }
}

@keyframes slideIn {
    from {
        transform: translateY(30px);
        opacity: 0;
    }
    to {
        transform: translateY(0);
        opacity: 1;
    }
}

/* Loading animation */
.carousel-container::before {
    content: '';
    position: absolute;
    top: 0;
    left: -100%;
    width: 100%;
    height: 100%;
    background: linear-gradient(90deg, transparent, rgba(255,255,255,0.1), transparent);
    animation: shimmer 2s infinite;
    z-index: 1;
}

@keyframes shimmer {
    0% {
        left: -100%;
    }
    100% {
        left: 100%;
    }
}
</style>

<script type="rocketlazyloadscript">
class AwesomeCarousel {
    constructor() {
        this.currentIndex = 0;
        this.track = document.getElementById('carouselTrack');
        this.slides = this.track.querySelectorAll('.slide');
        this.dots = document.querySelectorAll('.dot');
        this.progressBar = document.getElementById('progressBar');
        this.slideCount = this.slides.length;
        this.autoPlayInterval = null;
        this.autoPlayDuration = 4000;
        this.progressInterval = null;
        
        // Touch handling
        this.startX = 0;
        this.currentX = 0;
        this.isDragging = false;
        this.startTime = 0;
        
        this.init();
    }
    
    init() {
        this.setupEventListeners();
        this.updateCarousel(0);
        this.startAutoPlay();
        this.hideSwipeHint();
        
        // Add loading effect
        setTimeout(() => {
            this.track.parentElement.style.opacity = '1';
        }, 100);
    }
    
    setupEventListeners() {
        // Dot navigation
        this.dots.forEach((dot, index) => {
            dot.addEventListener('click', (e) => {
                e.preventDefault();
                this.goToSlide(index);
                this.addClickRipple(dot, e);
            });
        });
        
        // Touch events for mobile
        this.track.addEventListener('touchstart', this.handleTouchStart.bind(this), { passive: false });
        this.track.addEventListener('touchmove', this.handleTouchMove.bind(this), { passive: false });
        this.track.addEventListener('touchend', this.handleTouchEnd.bind(this), { passive: false });
        
        // Mouse events for desktop
        this.track.addEventListener('mousedown', this.handleMouseStart.bind(this));
        this.track.addEventListener('mousemove', this.handleMouseMove.bind(this));
        this.track.addEventListener('mouseup', this.handleMouseEnd.bind(this));
        this.track.addEventListener('mouseleave', this.handleMouseEnd.bind(this));
        
        // Prevent context menu and drag
        this.track.addEventListener('contextmenu', (e) => e.preventDefault());
        this.track.addEventListener('dragstart', (e) => e.preventDefault());
        
        // Pause on hover/focus
        this.track.addEventListener('mouseenter', () => this.pauseAutoPlay());
        this.track.addEventListener('mouseleave', () => this.startAutoPlay());
        
        // Visibility change handling
        document.addEventListener('visibilitychange', () => {
            if (document.hidden) {
                this.pauseAutoPlay();
            } else {
                this.startAutoPlay();
            }
        });
        
        // Keyboard navigation
        document.addEventListener('keydown', (e) => {
            if (e.key === 'ArrowLeft') this.prevSlide();
            if (e.key === 'ArrowRight') this.nextSlide();
        });
    }
    
    handleTouchStart(e) {
        this.handleStart(e.touches[0].clientX);
        e.preventDefault();
    }
    
    handleMouseStart(e) {
        this.handleStart(e.clientX);
        e.preventDefault();
    }
    
    handleStart(clientX) {
        this.startX = clientX;
        this.currentX = clientX;
        this.isDragging = true;
        this.startTime = Date.now();
        this.track.classList.add('touching');
        this.pauseAutoPlay();
    }
    
    handleTouchMove(e) {
        if (!this.isDragging) return;
        this.handleMove(e.touches[0].clientX);
        e.preventDefault();
    }
    
    handleMouseMove(e) {
        if (!this.isDragging) return;
        this.handleMove(e.clientX);
        e.preventDefault();
    }
    
    handleMove(clientX) {
        this.currentX = clientX;
        const deltaX = this.currentX - this.startX;
        const currentTransform = -this.currentIndex * 100;
        const dragPercentage = (deltaX / this.track.offsetWidth) * 100;
        
        // Add resistance at edges
        let finalTransform = currentTransform + dragPercentage;
        if (this.currentIndex === 0 && deltaX > 0) {
            finalTransform = dragPercentage * 0.3;
        } else if (this.currentIndex === this.slideCount - 1 && deltaX < 0) {
            finalTransform = currentTransform + (dragPercentage * 0.3);
        }
        
        this.track.style.transform = `translateX(${finalTransform}%)`;
    }
    
    handleTouchEnd(e) {
        this.handleEnd();
        e.preventDefault();
    }
    
    handleMouseEnd(e) {
        this.handleEnd();
    }
    
    handleEnd() {
        if (!this.isDragging) return;
        
        this.track.classList.remove('touching');
        this.track.classList.add('releasing');
        
        const deltaX = this.currentX - this.startX;
        const deltaTime = Date.now() - this.startTime;
        const velocity = Math.abs(deltaX) / deltaTime;
        
        // Determine if swipe was significant enough
        const threshold = this.track.offsetWidth * 0.15;
        const isQuickSwipe = velocity > 0.5;
        const isSignificantSwipe = Math.abs(deltaX) > threshold;
        
        if (isQuickSwipe || isSignificantSwipe) {
            if (deltaX > 0 && this.currentIndex > 0) {
                this.prevSlide();
            } else if (deltaX < 0 && this.currentIndex < this.slideCount - 1) {
                this.nextSlide();
            } else {
                this.updateCarousel(this.currentIndex);
            }
        } else {
            this.updateCarousel(this.currentIndex);
        }
        
        setTimeout(() => {
            this.track.classList.remove('releasing');
        }, 400);
        
        this.isDragging = false;
        this.startAutoPlay();
    }
    
    updateCarousel(index) {
        this.currentIndex = index;
        this.track.style.transform = `translateX(${-index * 100}%)`;
        
        // Update dots
        this.dots.forEach(dot => dot.classList.remove('active'));
        this.dots[index].classList.add('active');
        
        // Update slides
        this.slides.forEach(slide => slide.classList.remove('active'));
        this.slides[index].classList.add('active');
        
        // Reset progress
        this.resetProgress();
    }
    
    goToSlide(index) {
        if (index === this.currentIndex) return;
        this.pauseAutoPlay();
        this.updateCarousel(index);
        setTimeout(() => this.startAutoPlay(), 500);
    }
    
    nextSlide() {
        const nextIndex = (this.currentIndex + 1) % this.slideCount;
        this.updateCarousel(nextIndex);
    }
    
    prevSlide() {
        const prevIndex = this.currentIndex === 0 ? this.slideCount - 1 : this.currentIndex - 1;
        this.updateCarousel(prevIndex);
    }
    
    startAutoPlay() {
        this.pauseAutoPlay();
        this.startProgress();
        
        this.autoPlayInterval = setInterval(() => {
            this.nextSlide();
        }, this.autoPlayDuration);
    }
    
    pauseAutoPlay() {
        if (this.autoPlayInterval) {
            clearInterval(this.autoPlayInterval);
            this.autoPlayInterval = null;
        }
        this.pauseProgress();
    }
    
    startProgress() {
        this.pauseProgress();
        let progress = 0;
        const increment = 100 / (this.autoPlayDuration / 50);
        
        this.progressInterval = setInterval(() => {
            progress += increment;
            if (progress >= 100) {
                progress = 100;
                this.pauseProgress();
            }
            this.progressBar.style.width = `${progress}%`;
        }, 50);
    }
    
    pauseProgress() {
        if (this.progressInterval) {
            clearInterval(this.progressInterval);
            this.progressInterval = null;
        }
    }
    
    resetProgress() {
        this.progressBar.style.width = '0%';
        if (this.autoPlayInterval) {
            this.startProgress();
        }
    }
    
    addClickRipple(element, event) {
        const ripple = document.createElement('div');
        const rect = element.getBoundingClientRect();
        const size = Math.max(rect.width, rect.height);
        const x = event.clientX - rect.left - size / 2;
        const y = event.clientY - rect.top - size / 2;
        
        ripple.style.cssText = `
            position: absolute;
            width: ${size}px;
            height: ${size}px;
            left: ${x}px;
            top: ${y}px;
            background: rgba(255,255,255,0.5);
            border-radius: 50%;
            transform: scale(0);
            animation: ripple 0.6s ease-out;
            pointer-events: none;
            z-index: 100;
        `;
        
        element.style.position = 'relative';
        element.appendChild(ripple);
        
        setTimeout(() => ripple.remove(), 600);
    }
    
    hideSwipeHint() {
        setTimeout(() => {
            const hint = document.querySelector('.swipe-hint');
            if (hint) {
                hint.style.opacity = '0';
                setTimeout(() => hint.style.display = 'none', 500);
            }
        }, 5000);
    }
}

// Add ripple animation
const style = document.createElement('style');
style.textContent = `
    @keyframes ripple {
        to {
            transform: scale(2);
            opacity: 0;
        }
    }
`;
document.head.appendChild(style);

// Initialize carousel when DOM is loaded
document.addEventListener('DOMContentLoaded', () => {
    new AwesomeCarousel();
});

// Initialize immediately if DOM is already loaded
if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', () => {
        new AwesomeCarousel();
    });
} else {
    new AwesomeCarousel();
}
</script>				</div>
