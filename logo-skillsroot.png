<link data-minify="1" rel='stylesheet' id='main-style-css' href='https://skillsroot.org.in/wp-content/cache/min/1/wp-content/themes/csr-theme/style.css?ver=1774158188' type='text/css' media='all' />
<style id='success-stories-style-inline-css' type='text/css'>

        .success-stories-container {
            display: grid;
            grid-template-columns: repeat(auto-fill, minmax(300px, 1fr));
            gap: 20px;
            margin: 20px 0;
        }
        
        .success-story-item {
            background: #f9f9f9;
            border: 1px solid #e0e0e0;
            border-radius: 8px;
            padding: 20px;
            transition: transform 0.3s ease, box-shadow 0.3s ease;
            overflow: hidden;
        }
        
        .success-story-item:hover {
            transform: translateY(-5px);
            box-shadow: 0 5px 15px rgba(0,0,0,0.1);
        }
        
        .success-story-photo {
            margin: -20px -20px 20px -20px;
            overflow: hidden;
        }
        
        .success-story-photo img {
            width: 100%;
            height: 200px;
            object-fit: cover;
            display: block;
        }
        
        .success-story-item h3 {
            color: #2c3e50;
            margin-top: 0;
            border-bottom: 2px solid #3498db;
            padding-bottom: 10px;
        }
        
        .story-content {
            margin: 15px 0;
            line-height: 1.6;
        }
        
        .success-story-item p {
            margin: 8px 0;
        }
    
/*# sourceURL=success-stories-style-inline-css */
