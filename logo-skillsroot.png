<style>
@import url('https://fonts.googleapis.com/css2?family=Poppins:wght@400;500;600;700;800;900&display=swap');

* {
    box-sizing: border-box;
}

.stats-section {
    padding: 40px 15px;
   
    position: relative;
    overflow: hidden;
    font-family: 'Poppins', sans-serif;
}

.stats-section::before {
    content: '';
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    background: 
        radial-gradient(circle at 25% 25%, rgba(47, 121, 188, 0.05) 0%, transparent 50%),
        radial-gradient(circle at 75% 75%, rgba(255, 215, 0, 0.05) 0%, transparent 50%);
    pointer-events: none;
}

.stats-container {
    max-width: 100%;
    margin: 0 auto;
    position: relative;
    z-index: 2;
}

.stats-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 20px;
    align-items: stretch;
}

.stat-card {
    background: rgba(255, 255, 255, 0.95);
    backdrop-filter: blur(10px);
    border-radius: 20px;
    padding: 25px 20px;
    text-align: center;
    position: relative;
    border: 1px solid rgba(0, 0, 0, 0.05);
    box-shadow: 
        0 8px 25px rgba(0, 0, 0, 0.08),
        inset 0 1px 0 rgba(255, 255, 255, 0.9);
    transition: all 0.4s cubic-bezier(0.25, 0.46, 0.45, 0.94);
    cursor: pointer;
    overflow: hidden;
    opacity: 0;
    transform: translateY(30px);
    animation: slideInUp 0.6s ease forwards;
    min-height: 160px;
    display: flex;
    flex-direction: column;
    justify-content: center;
}

.stat-card:nth-child(1) { animation-delay: 0.1s; }
.stat-card:nth-child(2) { animation-delay: 0.2s; }
.stat-card:nth-child(3) { animation-delay: 0.3s; }
.stat-card:nth-child(4) { animation-delay: 0.4s; }

.stat-card:active {
    transform: translateY(-5px) scale(0.98);
}

.stat-card::before {
    content: '';
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    height: 3px;
    background: linear-gradient(90deg, #2F79BC, #4A9FE7, #FFD700);
    opacity: 0;
    transition: opacity 0.3s ease;
}

.stat-card:active::before {
    opacity: 1;
}

/* Icon Container - Mobile Optimized */
.icon-container {
    position: relative;
    width: 50px;
    height: 50px;
    margin: 0 auto 15px;
    display: flex;
    align-items: center;
    justify-content: center;
}

.icon-container i {
    font-size: 2rem;
    color: #2F79BC;
    z-index: 2;
    position: relative;
}

.icon-pulse {
    position: absolute;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
    width: 60px;
    height: 60px;
    border-radius: 50%;
    background: rgba(47, 121, 188, 0.1);
    animation: pulse 2.5s ease-in-out infinite;
}

/* Mobile-First Icon Animations */
.rotating-icon {
    animation: rotate 3s linear ;
}

.floating-icon {
    animation: float 2.5s ease-in-out infinite;
}

.scaling-icon {
    animation: scale 2s ease-in-out infinite;
}

.bouncing-icon {
    animation: bounce 2s ease-in-out infinite;
}

/* Stat Content - Mobile Optimized */
.stat-content {
    position: relative;
    z-index: 2;
}

.stat-number {
    font-size: 2.2rem;
    font-weight: 900;
    color: #000000;
    margin-bottom: 5px;
    line-height: 1;
    font-family: 'Poppins', sans-serif;
}

.stat-label {
    font-size: 0.85rem;
    color: #000000;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.5px;
    opacity: 0.8;
    line-height: 1.2;
    font-family: 'Poppins', sans-serif;
}

/* Counter Animation */
.counter {
    display: inline-block;
}

/* Touch-Friendly Mobile Responsive */
@media (max-width: 480px) {
    .stats-section {
        padding: 30px 10px;
    }
    
    .stats-grid {
        gap: 15px;
    }
    
    .stat-card {
        padding: 20px 15px;
        border-radius: 15px;
        min-height: 140px;
    }
    
    .icon-container {
        width: 45px;
        height: 45px;
        margin-bottom: 12px;
    }
    
    .icon-container i {
        font-size: 1.8rem;
    }
    
    .icon-pulse {
        width: 55px;
        height: 55px;
    }
    
    .stat-number {
        font-size: 2rem;
    }
    
    .stat-label {
        font-size: 0.8rem;
    }
}

@media (max-width: 360px) {
    .stats-section {
        padding: 25px 8px;
    }
    
    .stats-grid {
        gap: 12px;
    }
    
    .stat-card {
        padding: 18px 12px;
        min-height: 130px;
    }
    
    .icon-container {
        width: 40px;
        height: 40px;
        margin-bottom: 10px;
    }
    
    .icon-container i {
        font-size: 1.6rem;
    }
    
    .stat-number {
        font-size: 1.8rem;
    }
    
    .stat-label {
        font-size: 0.75rem;
        letter-spacing: 0.3px;
    }
}

/* Keyframe Animations - Optimized for Mobile */
@keyframes slideInUp {
    to {
        opacity: 1;
        transform: translateY(0);
    }
}

@keyframes rotate {
    0% { transform: rotate(0deg); }
    100% { transform: rotate(360deg); }
}

@keyframes float {
    0%, 100% { 
        transform: translateY(0); 
    }
    50% { 
        transform: translateY(-5px); 
    }
}

@keyframes scale {
    0%, 100% { 
        transform: scale(1); 
    }
    50% { 
        transform: scale(1.1); 
    }
}

@keyframes bounce {
    0%, 20%, 50%, 80%, 100% {
        transform: translateY(0);
    }
    40% {
        transform: translateY(-5px);
    }
    60% {
        transform: translateY(-2px);
    }
}

@keyframes pulse {
    0%, 100% {
        transform: translate(-50%, -50%) scale(1);
        opacity: 0.2;
    }
    50% {
        transform: translate(-50%, -50%) scale(1.1);
        opacity: 0.05;
    }
}

@keyframes countUp {
    from {
        transform: translateY(10px);
        opacity: 0;
    }
    to {
        transform: translateY(0);
        opacity: 1;
    }
}

/* Touch feedback */
@media (hover: none) and (pointer: coarse) {
    .stat-card:hover {
        transform: none;
    }
    
    .stat-card:active {
        transform: translateY(-2px) scale(0.98);
        box-shadow: 
            0 5px 15px rgba(0, 0, 0, 0.15),
            inset 0 1px 0 rgba(255, 255, 255, 0.9);
    }
}
</style>

<!-- Font Awesome Icons -->
<link data-minify="1" rel="stylesheet" href="https://skillsroot.org.in/wp-content/cache/min/1/ajax/libs/font-awesome/6.0.0/css/all.min.css?ver=1774158188">

<script type="rocketlazyloadscript">
class MobileAnimatedStats {
    constructor() {
        this.cards = document.querySelectorAll('.stat-card');
        this.counters = document.querySelectorAll('.counter');
        this.hasAnimated = false;
        
        this.init();
    }
    
    init() {
        this.setupIntersectionObserver();
        this.addTouchEffects();
        this.optimizeForMobile();
    }
    
    setupIntersectionObserver() {
        const observer = new IntersectionObserver((entries) => {
            entries.forEach(entry => {
                if (entry.isIntersecting && !this.hasAnimated) {
                    this.animateCounters();
                    this.hasAnimated = true;
                }
            });
        }, {
            threshold: 0.3,
            rootMargin: '50px'
        });
        
        observer.observe(document.querySelector('.stats-grid'));
    }
    
    animateCounters() {
        this.counters.forEach((counter, index) => {
            const card = counter.closest('.stat-card');
            const targetValue = parseInt(card.dataset.count);
            
            setTimeout(() => {
                this.animateCounter(counter, targetValue, index);
            }, index * 150);
        });
    }
    
    animateCounter(counter, target, index) {
        let current = 0;
        const increment = target / 60; // Faster for mobile
        const duration = 1500; // Shorter duration
        const stepTime = duration / 60;
        
        const formatValue = (value) => {
            switch(index) {
                case 0: // 30K+ upskilled
                    return Math.floor(value / 1000);
                case 1: // 2 Lakh+ livelihoods
                    return Math.floor(value / 100000);
                case 2: // 1K+ trainers
                    return Math.floor(value / 1000);
                case 3: // 100+ centers
                    return Math.floor(value);
                default:
                    return Math.floor(value);
            }
        };
        
        const timer = setInterval(() => {
            current += increment;
            if (current >= target) {
                current = target;
                clearInterval(timer);
            }
            
            counter.textContent = formatValue(current);
            
            if (current >= target) {
                counter.style.animation = 'countUp 0.3s ease';
                this.addCompleteEffect(counter.closest('.stat-card'));
            }
        }, stepTime);
    }
    
    addCompleteEffect(card) {
        // Brief highlight effect when counter completes
        card.style.boxShadow = '0 12px 30px rgba(47, 121, 188, 0.2)';
        setTimeout(() => {
            card.style.boxShadow = '';
        }, 800);
    }
    
    addTouchEffects() {
        this.cards.forEach((card, index) => {
            // Touch start
            card.addEventListener('touchstart', (e) => {
                e.preventDefault();
                card.style.transform = 'translateY(-3px) scale(0.98)';
                
                // Add ripple effect
                this.addTouchRipple(card, e.touches[0]);
            }, { passive: false });
            
            // Touch end
            card.addEventListener('touchend', (e) => {
                e.preventDefault();
                setTimeout(() => {
                    card.style.transform = '';
                }, 100);
            }, { passive: false });
            
            // Prevent scroll when touching cards
            card.addEventListener('touchmove', (e) => {
                e.preventDefault();
            }, { passive: false });
        });
    }
    
    addTouchRipple(card, touch) {
        const ripple = document.createElement('div');
        const rect = card.getBoundingClientRect();
        const size = Math.max(rect.width, rect.height) * 0.8;
        const x = touch.clientX - rect.left - size / 2;
        const y = touch.clientY - rect.top - size / 2;
        
        ripple.style.cssText = `
            position: absolute;
            border-radius: 50%;
            background: rgba(47, 121, 188, 0.2);
            width: ${size}px;
            height: ${size}px;
            left: ${x}px;
            top: ${y}px;
            transform: scale(0);
            animation: mobileRipple 0.6s ease-out;
            pointer-events: none;
            z-index: 1;
        `;
        
        card.appendChild(ripple);
        
        setTimeout(() => {
            ripple.remove();
        }, 600);
    }
    
    optimizeForMobile() {
        // Reduce animation intensity on slower devices
        const isSlowDevice = navigator.hardwareConcurrency && navigator.hardwareConcurrency < 4;
        
        if (isSlowDevice) {
            const style = document.createElement('style');
            style.textContent = `
                .rotating-icon { animation-duration: 6s; }
                .floating-icon { animation-duration: 4s; }
                .scaling-icon { animation-duration: 3s; }
                .bouncing-icon { animation-duration: 3s; }
                .icon-pulse { animation-duration: 4s; }
            `;
            document.head.appendChild(style);
        }
        
        // Add performance monitoring
        if ('performance' in window) {
            const observer = new PerformanceObserver((list) => {
                const entries = list.getEntries();
                entries.forEach(entry => {
                    if (entry.duration > 16) { // More than one frame
                        console.log('Slow animation detected, reducing effects');
                    }
                });
            });
            observer.observe({ entryTypes: ['measure'] });
        }
    }
}

// Add mobile ripple animation
const style = document.createElement('style');
style.textContent = `
    @keyframes mobileRipple {
        to {
            transform: scale(1.2);
            opacity: 0;
        }
    }
`;
document.head.appendChild(style);

// Initialize for mobile
if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', () => {
        new MobileAnimatedStats();
    });
} else {
    new MobileAnimatedStats();
}

// Mobile-specific optimizations
document.addEventListener('DOMContentLoaded', () => {
    // Disable hover effects on mobile
    if ('ontouchstart' in window) {
        document.body.classList.add('touch-device');
    }
    
    // Optimize for battery life
    document.addEventListener('visibilitychange', () => {
        const icons = document.querySelectorAll('.icon-container i');
        if (document.hidden) {
            icons.forEach(icon => {
                icon.style.animationPlayState = 'paused';
            });
        } else {
            icons.forEach(icon => {
                icon.style.animationPlayState = 'running';
            });
        }
    });
    
    // Vibration feedback on touch (if supported)
    if ('vibrate' in navigator) {
        document.querySelectorAll('.stat-card').forEach(card => {
            card.addEventListener('touchstart', () => {
                navigator.vibrate(50); // Subtle haptic feedback
            });
        });
    }
});
</script>				</div>
